{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "src/shared/**/*",
    "../shared/editor/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"],
      "@editor/*": ["../shared/editor/*"],
      // shared/editor lives outside this project, and TS resolves bare imports by
      // walking up from the FILE — shared/ and the repo root have no node_modules,
      // so these have to be pointed at this app's copy. Same list as chrome's.
      "react": ["node_modules/@types/react"],
      "react/*": ["node_modules/@types/react/*"],
      "react-dom": ["node_modules/@types/react-dom"],
      "react-dom/*": ["node_modules/@types/react-dom/*"],
      "react/jsx-runtime": ["node_modules/@types/react/jsx-runtime"],
      "fabric": ["node_modules/fabric"],
      "lucide-react": ["node_modules/lucide-react"],
      "clsx": ["node_modules/clsx"],
      "tailwind-merge": ["node_modules/tailwind-merge"],
      "class-variance-authority": ["node_modules/class-variance-authority"]
    }
  }
}
